# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# --- Telegram: tu cuenta (userbot) — https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+520000000000
TG_SESSION_NAME=data/sessions/userbot

# --- Telegram: bot de control — @BotFather → /newbot
BOT_TOKEN=123456789:AA...
BOT_SESSION_NAME=data/sessions/bot
# Tu user ID (lo muestra `python -m jobhunter login`)
OWNER_USER_ID=

# --- IA (fase 2) — https://aistudio.google.com → Get API key
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# --- Email (fase 3) — Gmail: contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- General
TZ=America/Havana
LOG_LEVEL=INFO
DATA_DIR=data
DATABASE_PATH=data/jobhunter.db
CONFIG_PATH=config.yaml
# Si se define, sobrescribe sending.dry_run de config.yaml (true = no se envía nada)
# SENDING_DRY_RUN=true
